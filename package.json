{
  "name": "huntpilot",
  "version": "0.2.2",
  "description": "HuntPilot: a referral-first AI job search copilot. Templates, fit scoring and a tracker you can deploy to Copilot Studio, Claude Projects or a custom GPT.",
  "license": "MIT",
  "author": "Jawad Ul Hadi",
  "type": "module",
  "files": [
    "dist",
    "templates",
    "examples",
    "evals",
    "docs",
    "LICENSE",
    "README.md"
  ],
  "bin": {
    "huntpilot": "dist/cli.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "cli": "npm run -s build && node dist/cli.js",
    "render": "npm run -s cli -- render",
    "check": "npm run -s cli -- check",
    "score": "npm run -s cli -- score",
    "tracker": "npm run -s cli -- tracker",
    "evals": "npm run -s cli -- evals",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "yaml": "2.8.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "5.6.3",
    "vitest": "5.0.5"
  }
}
